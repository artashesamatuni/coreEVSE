(footprint "Terminal_T44009_M4"
	(version 20250302)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "T44009 M4 high-current PCB solder terminal, 55 A, 8x8 mm body, four pins on 5 mm square; custom 1.9 mm finished holes")
	(tags "M4 terminal stud power 55A T44009")
	(property "Reference" "J**" (at 0 -5.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "T44009" (at 0 5.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(attr through_hole)
	(fp_rect (start -4 -4) (end 4 4) (stroke (width 0.25) (type solid)) (fill none) (layer "F.SilkS"))
	(fp_rect (start -4.15 -4.15) (end 4.15 4.15) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
	(fp_rect (start -4 -4) (end 4 4) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
	(fp_circle (center 0 0) (end 2.2 0) (stroke (width 0.2) (type solid)) (fill none) (layer "F.SilkS"))
	(fp_text user "M4" (at 0 0 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(pad "1" thru_hole roundrect (at -2.5 -2.5) (size 3.2 3.2) (drill 1.9) (layers "*.Cu" "*.Mask") (roundrect_rratio 0.2))
	(pad "1" thru_hole circle (at 2.5 -2.5) (size 3.2 3.2) (drill 1.9) (layers "*.Cu" "*.Mask"))
	(pad "1" thru_hole circle (at 2.5 2.5) (size 3.2 3.2) (drill 1.9) (layers "*.Cu" "*.Mask"))
	(pad "1" thru_hole circle (at -2.5 2.5) (size 3.2 3.2) (drill 1.9) (layers "*.Cu" "*.Mask"))
	(model "${KIPRJMOD}/OpenEVSE.3dshapes/T44009.step"
		(offset (xyz 0 0 0))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
