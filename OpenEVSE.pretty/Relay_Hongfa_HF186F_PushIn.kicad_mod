(footprint "Relay_Hongfa_HF186F_PushIn"
	(version 20250302)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Hongfa HF186F PCB Push-In relay, 1 Form A, 55 A; bottom-view layout per HF186F datasheet")
	(tags "relay SPST NO HF186F 12V 55A push-in")
	(property "Reference" "K**" (at 0 -11.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "HF186F" (at 0 11.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(attr through_hole)
	(fp_rect (start -15 -10) (end 15 10) (stroke (width 0.25) (type solid)) (fill none) (layer "F.SilkS"))
	(fp_rect (start -15.25 -10.25) (end 15.25 10.25) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
	(fp_rect (start -15 -10) (end 15 10) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
	(fp_circle (center -13.3 -7.8) (end -12.8 -7.8) (stroke (width 0.2) (type solid)) (fill solid) (layer "F.SilkS"))
	(fp_text user "${REFERENCE}" (at 0 0 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(pad "13" thru_hole rect (at -12.35 -5.08) (size 3.6 3.6) (drill 1.4) (layers "*.Cu" "*.Mask"))
	(pad "14" thru_hole circle (at -12.35 5.08) (size 3.6 3.6) (drill 1.4) (layers "*.Cu" "*.Mask"))
	(pad "A1" thru_hole circle (at 12.25 -5.08) (size 2.2 2.2) (drill 0.9) (layers "*.Cu" "*.Mask"))
	(pad "A2" thru_hole circle (at 12.25 5.08) (size 2.2 2.2) (drill 0.9) (layers "*.Cu" "*.Mask"))
	(model "${KIPRJMOD}/OpenEVSE.3dshapes/HF186F.step"
		(offset (xyz -14.25 -9.25 0.4))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
	(embedded_fonts no)
)
